# postgres or mysql
DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@host:5432/four_t
# DATABASE_SSL=false only for local database
DATABASE_SSL=true
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=https://your-domain.example
# Optional. Set the same token in the browser client before production use.
SYNC_TOKEN=replace-with-a-long-random-secret
